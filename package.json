{
  "name": "ascii-dungeon",
  "version": "1.0.0",
  "description": "A turn-based ASCII maze crawler: descend 100 procedurally generated floors with fog of war, 3 lives and 17 kinds of enemy.",
  "license": "MIT",
  "author": "Fabio Roman",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build:web": "tsc -p tsconfig.json --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.core.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "gen": "tsx scripts/gen-map.ts",
    "solve": "tsx scripts/solve.ts",
    "fairness": "tsx scripts/fairness.ts",
    "version:sync": "tsx scripts/sync-version.ts",
    "android:sync": "npm run build:web && cap sync android",
    "build:android": "tsx scripts/build-android.ts debug",
    "release:android": "tsx scripts/build-android.ts release"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@fontsource/jetbrains-mono": "^5.3.0"
  }
}
